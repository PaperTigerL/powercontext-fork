# Dify 1.9.1 自托管 .env 的关键覆盖项（其余沿用官方 .env.example）
EXPOSE_NGINX_PORT=8088

# HTTP Request 节点默认经 ssrf_proxy 出网；官方 squid 允许 Docker 内网来源访问私网地址，
# 本次实测保持以下默认值即可访问 host.docker.internal。若你自定义了 SSRF 策略，需自行放行。
SSRF_PROXY_HTTP_URL=http://ssrf_proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf_proxy:3128

# 本地验证留空即可
CONSOLE_API_URL=
APP_WEB_URL=
